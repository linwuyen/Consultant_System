{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "consultant-system",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-09",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["17 1 * * *"]
  },
  "observability": {
    "enabled": true
  }
}
